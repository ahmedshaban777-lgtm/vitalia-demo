rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMerchant() {
      return request.auth != null
        && request.auth.uid == 'NVBntrKCMAN9GY1gatJYz4CKook2';
    }

    function validStatus(s) {
      return s in ['new', 'prep', 'ready', 'done'];
    }

    function validItemsString(v) {
      return v is string
        && v.matches('^([A-Z0-9]{6}\\.[0-9]{1,3})(,[A-Z0-9]{6}\\.[0-9]{1,3})*$')
        && v.size() <= 700;
    }

    function validTotal(v) {
      return v is int && v >= 0 && v <= 1000000;
    }

    // Private order details (PII). Customers create; only merchant reads/updates/deletes.
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['code','createdAt','name','method','address','phone','notes','items','total','status'])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new'
        && validItemsString(request.resource.data.items)
        && validTotal(request.resource.data.total)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.method in ['delivery','pickup']
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 300
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 300;
      allow read, delete: if isMerchant();
      allow update: if isMerchant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && validStatus(request.resource.data.status);
    }

    // Public minimal status (no PII). Anyone can GET one doc by its unguessable id; no listing.
    match /order_status/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['code','createdAt','items','total','status'])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new'
        && validItemsString(request.resource.data.items)
        && validTotal(request.resource.data.total);
      allow get: if true;
      allow list: if false;
      allow update: if isMerchant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && validStatus(request.resource.data.status);
      allow delete: if isMerchant();
    }
  }
}
